rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    function isSignedIn() {
      return request.auth != null;
    }
    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function userTenantId() {
      return userData().tenantId;
    }
    // Handles both a single 'role' string field and a 'roles' array field.
    function hasRole(role) {
      return (userData().roles != null && role in userData().roles)
          || (userData().role == role);
    }
    function isSuperAdmin() {
      return userData().role == 'super_admin';
    }
    function isCongregationMember() {
      return userData().role == 'congregation_member';
    }
    // True for any user who has a linked member profile - this includes
    // congregation members AND admin/team users who have linked themselves
    // to a roster record via the Profile page. Use this instead of
    // isCongregationMember() for all "member can read/write their own data" rules.
    function hasLinkedMemberProfile() {
      return userData().memberId is string && userData().memberId.size() > 0;
    }
    // Returns true if the signed-in congregation member owns the given resource
    // (their member doc has their authUid stored on it)
    function isOwnMemberDoc(resource) {
      return isCongregationMember()
          && resource.data.authUid == request.auth.uid;
    }
    function isOwner() {
      return isSuperAdmin() || hasRole('owner');
    }
    function canManageUsers() {
      return isOwner();
    }
    function canEditChurchProfile() {
      return isOwner() || hasRole('admin');
    }
    function canManageMembers() {
      return isSuperAdmin() || hasRole('owner') || hasRole('admin') || hasRole('member_manager') || hasRole('branch_admin');
    }
    function canReadMembers() {
      return isSuperAdmin() || hasRole('owner') || hasRole('admin') || hasRole('member_manager') || hasRole('member_viewer') || hasRole('viewer') || hasRole('cell_leader') || hasRole('branch_admin') || hasRole('finance') || hasRole('finance_viewer');
    }
    function canManageAttendance() {
      return isSuperAdmin() || hasRole('owner') || hasRole('admin') || hasRole('member_manager') || hasRole('cell_leader') || hasRole('branch_admin');
    }
    function canReadAttendance() {
      return isSuperAdmin() || hasRole('owner') || hasRole('admin') || hasRole('member_manager') || hasRole('member_viewer') || hasRole('viewer') || hasRole('cell_leader') || hasRole('branch_admin');
    }
    function canManageFinance() {
      return isSuperAdmin() || hasRole('owner') || hasRole('admin') || hasRole('finance');
    }
    function canReadFinance() {
      return isSuperAdmin() || hasRole('owner') || hasRole('admin') || hasRole('finance') || hasRole('finance_viewer') || hasRole('viewer') || hasRole('branch_admin');
    }
    function canManageCommunications() {
      return isSuperAdmin() || hasRole('owner') || hasRole('admin');
    }
    // Follow-up team: the dedicated follow_up role, the manager roles that already
    // handle guests, plus ANY team member switched on in the "Follow-Up Team"
    // toggle (stored as visitorMinistry). These people may work first-time guests
    // and their follow-ups regardless of their main role.
    function canDoFollowUp() {
      return isSuperAdmin() || hasRole('owner') || hasRole('admin') || hasRole('member_manager')
          || hasRole('follow_up') || hasRole('branch_admin')
          || userData().get('visitorMinistry', false) == true;
    }
    // True when the caller is a cell leader whose assigned region matches the one
    // passed in. Used to scope SOP checklist runs to a leader's own group.
    function ownsChecklistRegion(region) {
      return hasRole('cell_leader') && region == userData().assignedCellRegion;
    }
    function sameTenant(resource) {
      return resource.data.tenantId == userTenantId();
    }
    function settingOwnTenant(newData) {
      return newData.tenantId == userTenantId();
    }
    function tenantAllowed(resource) {
      return isSuperAdmin() || sameTenant(resource);
    }
    function tenantAllowedWrite(newData) {
      return isSuperAdmin() || settingOwnTenant(newData);
    }

    // ---- Free-tier member cap ----------------------------------------------
    // Reads the tenant doc to enforce the free-tier limit. Costs one extra
    // document read per member create, which is acceptable.
    function tenantBilling(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)).data;
    }
    // Allows the create UNLESS the tenant is explicitly on the free tier with a
    // known count at or above a known limit. It is deliberately permissive on
    // missing data: if the tenant doc is absent, or tier / activeMemberCount /
    // memberLimit have not been set yet (a church that predates the backfill),
    // it does NOT block. That way the rule can never lock out a church whose
    // count has not been established. Run the backfill so this never happens in
    // practice, then this check is exact.
    function withinMemberLimit(newData) {
      return !exists(/databases/$(database)/documents/tenants/$(newData.tenantId))
          || tenantBilling(newData.tenantId).tier != 'free'
          || !('activeMemberCount' in tenantBilling(newData.tenantId))
          || !('memberLimit' in tenantBilling(newData.tenantId))
          || tenantBilling(newData.tenantId).activeMemberCount
               < tenantBilling(newData.tenantId).memberLimit;
    }

    // ---- Paid-plan feature gate --------------------------------------------
    // Reads the CALLER's own tenant tier to gate paid-only features (events,
    // worship, volunteers, forms, workflows, daily summary). Permissive when the
    // tier is unset (a tenant that predates the backfill) and for super admins,
    // so nothing breaks before the backfill runs. Blocks only when the tenant is
    // explicitly on the "free" tier.
    function callerIsPaid() {
      return isSuperAdmin()
          || !exists(/databases/$(database)/documents/tenants/$(userTenantId()))
          || !('tier' in tenantBilling(userTenantId()))
          || tenantBilling(userTenantId()).tier != 'free';
    }

    // ============================================
    // LOGIN AUDIT COLLECTION
    // ============================================
    // Written ONLY by the server (/api/login) using the Admin SDK, which bypasses
    // these rules. Clients may never write here, guaranteeing the trail is tamper
    // proof. Owners and admins can read their own tenant's sign-in history.
    match /login_audit/{id} {
      allow read: if isSignedIn()
                  && tenantAllowed(resource)
                  && (isOwner() || hasRole('admin'));
      allow write: if false;
    }

    // Platform admin audit trail. Records destructive/important admin actions
    // (suspend, reactivate, delete, ticket reply, convert to beta, auto actions).
    // Written ONLY by server routes using the Admin SDK, which bypass these
    // rules. Clients may never write here, keeping the trail tamper proof. Only
    // super admins may read it.
    match /admin_audit/{id} {
      allow read: if isSignedIn() && isSuperAdmin();
      allow write: if false;
    }

    // ============================================
    // TENANTS COLLECTION
    // ============================================
    match /tenants/{tenantId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn()
                  && (isSuperAdmin() || tenantId == userTenantId());
      allow update: if isSignedIn()
                    && (isSuperAdmin() || (tenantId == userTenantId() && canEditChurchProfile()));
      allow delete: if isSignedIn() && isSuperAdmin();
    }

    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{userId} {
      // SECURITY: user docs are ONLY ever created server-side via the Admin SDK
      // (/api/signup creates role:"owner", /api/login creates role:"user",
      // /api/invite-member + /api/bulk-invite-members create congregation members).
      // The Admin SDK bypasses these rules, so no client path needs create access.
      // Denying client create closes the privilege-escalation hole where a signed-in
      // user could write their own users doc with role:"super_admin"/"viewer" and an
      // arbitrary tenantId to read another church's data.
      allow create: if false;

      // Read widened to managers so they can see the team list for DRI pickers.
      // Write stays restricted to the owner via canManageUsers() below.
      allow read: if isSignedIn()
                  && (userId == request.auth.uid
                      || isSuperAdmin()
                      || (sameTenant(resource) && canManageMembers()));

      allow update: if isSignedIn()
                    && (
                      isSuperAdmin()
                      || (userId == request.auth.uid
                          && request.resource.data.role == resource.data.role
                          && request.resource.data.roles == resource.data.roles
                          && request.resource.data.tenantId == resource.data.tenantId)
                      || (sameTenant(resource) && canManageUsers())
                    );

      allow delete: if isSignedIn()
                    && (isSuperAdmin() || (sameTenant(resource) && canManageUsers()));
    }

    // ============================================
    // MEMBERS COLLECTION
    // ============================================
    match /members/{memberId} {
      // Admin access
      allow read: if isSignedIn()
                  && tenantAllowed(resource)
                  && canReadMembers();
      // Congregation member can read and update their own doc only
      allow read: if isSignedIn() && isOwnMemberDoc(resource);
      allow update: if isSignedIn()
                    && isOwnMemberDoc(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && request.resource.data.authUid == resource.data.authUid;
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && canManageMembers()
                    && withinMemberLimit(request.resource.data);
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && canManageMembers();
      // Follow-up team: may touch the care follow-up stamp ONLY, so completing a
      // care workflow moves the member off the Care Tier Alerts list. No other
      // member field can be changed through this rule.
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && canDoFollowUp()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['careFollowUp']);
      allow delete: if isSignedIn()
                    && tenantAllowed(resource)
                    && canManageMembers();
    }

    // ============================================
    // ATTENDANCE COLLECTION
    // ============================================
    match /attendance/{recordId} {
      allow read: if isSignedIn()
                  && tenantAllowed(resource)
                  && canReadAttendance();
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && canManageAttendance();
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && canManageAttendance();
      allow delete: if isSignedIn()
                    && tenantAllowed(resource)
                    && canManageAttendance();
    }

    // ============================================
    // FINANCE: contributions, expenses, accounts
    // ============================================
    match /contributions/{id} {
      allow read: if isSignedIn()
                  && tenantAllowed(resource)
                  && canReadFinance();
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && canManageFinance();
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && canManageFinance();
      allow delete: if isSignedIn()
                    && tenantAllowed(resource)
                    && canManageFinance();
    }
    match /expenses/{id} {
      allow read: if isSignedIn()
                  && tenantAllowed(resource)
                  && canReadFinance();
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && canManageFinance();
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && canManageFinance();
      allow delete: if isSignedIn()
                    && tenantAllowed(resource)
                    && canManageFinance();
    }
    match /accounts/{id} {
      allow read: if isSignedIn()
                  && tenantAllowed(resource)
                  && canReadFinance();
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && canManageFinance();
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && canManageFinance();
      allow delete: if isSignedIn()
                    && tenantAllowed(resource)
                    && canManageFinance();
    }

    // ============================================
    // COMMUNICATIONS COLLECTION
    // ============================================
    match /communications/{docId} {
      allow read: if isSignedIn()
                  && tenantAllowed(resource)
                  && canManageCommunications();
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && canManageCommunications();
      // Cloud Function updates status via Admin SDK - no client update needed.
      allow update: if false;
      allow delete: if isSignedIn()
                    && tenantAllowed(resource)
                    && canManageCommunications();
    }

    // ============================================
    // HOUSEHOLDS COLLECTION
    // ============================================
    match /households/{id} {
      // Any user with a linked member profile can read their own household
      allow read: if isSignedIn()
                  && hasLinkedMemberProfile()
                  && resource.data.tenantId == userTenantId();
      allow read: if isSignedIn()
                  && tenantAllowed(resource)
                  && canReadMembers();
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && canManageMembers();
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && canManageMembers();
      allow delete: if isSignedIn()
                    && tenantAllowed(resource)
                    && canManageMembers();
    }

    // ============================================
    // VISITORS COLLECTION
    // ============================================
    match /visitors/{id} {
      allow read: if isSignedIn()
                  && tenantAllowed(resource)
                  && (canReadMembers() || canDoFollowUp());
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && (canManageMembers() || canDoFollowUp());
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && (canManageMembers() || canDoFollowUp());
      allow delete: if isSignedIn()
                    && tenantAllowed(resource)
                    && canManageMembers();
    }

    // ============================================
    // TRANSACTIONS COLLECTION
    // ============================================
    match /transactions/{id} {
      allow read: if isSignedIn()
                  && tenantAllowed(resource)
                  && canReadFinance();
      // Any user with a linked member profile can read their own transactions.
      // Works for congregation_member AND promoted/team users who have linked their profile.
      allow read: if isSignedIn()
                  && hasLinkedMemberProfile()
                  && resource.data.memberId == userData().memberId;
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && canManageFinance();
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && canManageFinance();
      allow delete: if isSignedIn()
                    && tenantAllowed(resource)
                    && canManageFinance();
    }

    // ============================================
    // STAGED TRANSACTIONS (imported statement rows awaiting review)
    // Same tenant isolation and finance permissions as transactions.
    // No member self-read: these are provisional and only finance staff touch them.
    // ============================================
    match /staged_transactions/{id} {
      allow read: if isSignedIn()
                  && tenantAllowed(resource)
                  && canReadFinance();
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && canManageFinance();
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && canManageFinance();
      allow delete: if isSignedIn()
                    && tenantAllowed(resource)
                    && canManageFinance();
    }

    // ============================================
    // SYSTEM ADMINS COLLECTION
    // ============================================
    match /system_admins/{id} {
      allow read: if isSignedIn() && isSuperAdmin();
      allow write: if isSignedIn() && isSuperAdmin();
    }

    // ============================================
    // DEMO REQUESTS (public marketing form submissions)
    // ============================================
    match /demo_requests/{id} {
      allow create: if true;
      allow read, update, delete: if isSignedIn() && isSuperAdmin();
    }

    // ============================================
    // SUPPORT TICKETS
    // Public: anyone can submit (marketing form, unauthenticated)
    // Tenant: owners/admins can read their own church's tickets
    // Super admin: full access
    // ============================================
    match /support_tickets/{id} {
      // Anyone can submit - public form and authenticated dashboard users
      allow create: if true;
      // Super admin: full access
      allow read, update, delete: if isSignedIn() && isSuperAdmin();
      // Tenant owner/admin: read only their own church's tickets
      allow read: if isSignedIn()
                  && resource.data.tenantId == userTenantId()
                  && (hasRole('owner') || hasRole('admin'));
    }

    // ============================================
    // ONLINE GIVING RECORDS
    // Public: anyone can create (unauthenticated giving form)
    // Finance roles: read their own tenant's records
    // Super admin: full access
    // ============================================
    match /giving_records/{id} {
      // Public giving form writes without auth
      allow create: if true;
      // Super admin full access
      allow read, update, delete: if isSignedIn() && isSuperAdmin();
      // Finance roles can read their own church records
      allow read: if isSignedIn()
                  && resource.data.tenantId == userTenantId()
                  && canReadFinance();
      // Finance roles can update (e.g. marking EFT as confirmed)
      allow update: if isSignedIn()
                    && resource.data.tenantId == userTenantId()
                    && canManageFinance();
    }

    // ============================================
    // FINANCE CATEGORIES (configurable per tenant)
    // Finance roles: read
    // Owner/Admin: full CRUD
    // Public giving API: read (via admin SDK, bypasses rules)
    // ============================================
    match /finance_categories/{id} {
      allow read: if isSignedIn()
                  && (isSuperAdmin() || (resource.data.tenantId == userTenantId() && canReadFinance()));
      allow create: if isSignedIn()
                    && request.resource.data.tenantId == userTenantId()
                    && (hasRole('owner') || hasRole('admin') || isSuperAdmin());
      allow update: if isSignedIn()
                    && resource.data.tenantId == userTenantId()
                    && (hasRole('owner') || hasRole('admin') || isSuperAdmin());
      allow delete: if isSignedIn()
                    && (isSuperAdmin() || (resource.data.tenantId == userTenantId()
                    && (hasRole('owner') || hasRole('admin'))));
    }

    // ============================================
    // CARE TIER FOLLOW-UP NOTES
    // ============================================
    match /careTierNotes/{id} {
      allow read: if isSignedIn()
                  && tenantAllowed(resource)
                  && canReadAttendance();
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && canManageAttendance();
      allow update: if false;
      allow delete: if isSignedIn()
                    && tenantAllowed(resource)
                    && canManageAttendance();
    }

    // ============================================
    // FORMS (church-built custom forms)
    // ============================================
    match /forms/{id} {
      // Public: anyone can read any form (active check is enforced in app code,
      // so inactive forms show "Form is closed" instead of "not found")
      allow read: if true;
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'))
                    && callerIsPaid();
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'))
                    && callerIsPaid();
      allow delete: if isSignedIn()
                    && (isSuperAdmin() || (tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin'))));
    }

    // ============================================
    // FORM SUBMISSIONS (public form responses)
    // ============================================
    match /form_submissions/{id} {
      // Anyone can submit (public form - no auth required)
      allow create: if true;
      // Super admin or tenant staff can read form submissions
      allow read: if isSignedIn()
                  && (isSuperAdmin() || (resource.data.tenantId == userTenantId()
                  && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'))));
      // No updates or deletes on submissions (immutable audit trail)
      allow update, delete: if isSignedIn() && isSuperAdmin();
    }

    // ============================================
    // WORKFLOWS (templates)
    // ============================================
    match /workflows/{id} {
      // Cell leaders may READ workflow definitions so they can run SOP checklists
      // scoped to their group. They still cannot create or edit workflows.
      allow read: if isSignedIn() && (isSuperAdmin() || (tenantAllowed(resource)
                  && (hasRole('owner') || hasRole('admin') || hasRole('member_manager') || hasRole('cell_leader') || canDoFollowUp())));
      allow create: if isSignedIn() && tenantAllowedWrite(request.resource.data)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'))
                    && callerIsPaid();
      allow update: if isSignedIn() && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'))
                    && callerIsPaid();
      allow delete: if isSignedIn()
                    && (isSuperAdmin() || (tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin'))));
    }
    match /workflow_steps/{id} {
      // Cell leaders may READ steps to snapshot them into an SOP checklist run.
      allow read: if isSignedIn() && (isSuperAdmin() || (tenantAllowed(resource)
                  && (hasRole('owner') || hasRole('admin') || hasRole('member_manager') || hasRole('cell_leader'))));
      // create/update: check new data; delete: check existing resource (request.resource.data is null on delete)
      allow create, update: if isSignedIn() && tenantAllowedWrite(request.resource.data)
                             && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'))
                             && callerIsPaid();
      allow delete: if isSignedIn()
                    && (isSuperAdmin() || (tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'))));
    }
    match /workflow_instances/{id} {
      // Managers see everything; the assignee can read their own follow-ups.
      allow read: if isSignedIn() && (isSuperAdmin() || (tenantAllowed(resource)
                  && (hasRole('owner') || hasRole('admin') || hasRole('member_manager')
                  || resource.data.assignedToUid == request.auth.uid)));
      allow create: if isSignedIn() && tenantAllowedWrite(request.resource.data)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager') || canDoFollowUp());
      allow update: if isSignedIn() && tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager')
                    || (canDoFollowUp() && resource.data.assignedToUid == request.auth.uid));
      allow delete: if isSignedIn()
                    && (isSuperAdmin() || (tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin'))));
    }
    match /workflow_instance_steps/{id} {
      // Managers see everything; the assignee can read + tick off their own steps.
      allow read: if isSignedIn() && (isSuperAdmin() || (tenantAllowed(resource)
                  && (hasRole('owner') || hasRole('admin') || hasRole('member_manager')
                  || resource.data.assignedToUid == request.auth.uid)));
      allow create: if isSignedIn() && tenantAllowedWrite(request.resource.data)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager') || canDoFollowUp());
      allow update: if isSignedIn() && tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager')
                    || resource.data.assignedToUid == request.auth.uid);
      allow delete: if isSignedIn()
                    && (isSuperAdmin() || (tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin'))));
    }

    // ============================================
    // SOP CHECKLIST RUNS
    // A "run" is one execution of a checklist-mode workflow (a dateless,
    // recurring SOP) for a single cell group. Items are embedded on the run doc
    // and ticked off in place. Cell leaders may read/create/update only runs for
    // their own assigned cell region; managers and admins see every group's runs.
    // ============================================
    match /checklist_runs/{id} {
      allow read: if isSignedIn() && (isSuperAdmin() || (tenantAllowed(resource)
                  && (hasRole('owner') || hasRole('admin') || hasRole('member_manager')
                  || ownsChecklistRegion(resource.data.cellRegion))));
      allow create: if isSignedIn() && tenantAllowedWrite(request.resource.data)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager')
                    || ownsChecklistRegion(request.resource.data.cellRegion))
                    && callerIsPaid();
      allow update: if isSignedIn() && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && request.resource.data.cellRegion == resource.data.cellRegion
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager')
                    || ownsChecklistRegion(resource.data.cellRegion))
                    && callerIsPaid();
      allow delete: if isSignedIn()
                    && (isSuperAdmin() || (tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin'))));
    }

    // ============================================
    // NOTES (timestamped audit notes under a parent doc)
    // Written by NotesPanel under members/*, visitors/*, and workflow_instances/*.
    // Each note stores its own tenantId so these rules keep them isolated per
    // church without reading the parent. Notes are an immutable trail: create
    // only, never edited or deleted. Any staff member who can see members or work
    // follow-ups can read them, so admins can always go back and see notes even
    // after a workflow is closed. (Firestore requires an explicit rule per parent;
    // a recursive wildcard can't be followed by /notes/{id}.)
    // ============================================
    function canReadNotes() {
      return isSuperAdmin()
          || (resource.data.tenantId == userTenantId() && (canReadMembers() || canDoFollowUp()));
    }
    function canCreateNote() {
      return isSuperAdmin()
          || (request.resource.data.tenantId == userTenantId() && (canManageMembers() || canDoFollowUp()));
    }
    match /members/{parentId}/notes/{noteId} {
      allow read: if isSignedIn() && canReadNotes();
      allow create: if isSignedIn() && canCreateNote();
      allow update, delete: if false;
    }
    match /visitors/{parentId}/notes/{noteId} {
      allow read: if isSignedIn() && canReadNotes();
      allow create: if isSignedIn() && canCreateNote();
      allow update, delete: if false;
    }
    match /workflow_instances/{parentId}/notes/{noteId} {
      allow read: if isSignedIn() && canReadNotes();
      allow create: if isSignedIn() && canCreateNote();
      allow update, delete: if false;
    }

    // ============================================
    // EVENTS
    // ============================================
    match /events/{id} {
      // Public can read active events so the RSVP link page can render event details
      allow read: if resource.data.active == true;
      // Any user with a linked member profile can read events for their church
      allow read: if isSignedIn()
                  && hasLinkedMemberProfile()
                  && resource.data.tenantId == userTenantId();
      allow read: if isSignedIn()
                  && (isSuperAdmin() || (tenantAllowed(resource)
                  && (hasRole('owner') || hasRole('admin') || hasRole('member_manager') || hasRole('viewer'))));
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'))
                    && callerIsPaid();
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'))
                    && callerIsPaid();
      allow delete: if isSignedIn()
                    && (isSuperAdmin() || (tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin'))));
    }

    // ============================================
    // EVENT RSVPS
    // Merged: public RSVP link + tenant staff + linked congregation members.
    // ============================================
    match /event_rsvps/{id} {
      // Public RSVP link: anyone can submit an RSVP without being logged in
      allow create: if true;
      // Read: super admin, tenant staff, or a linked member in the same tenant
      allow read: if isSignedIn()
                  && (
                    isSuperAdmin()
                    || (tenantAllowed(resource)
                        && (hasRole('owner') || hasRole('admin') || hasRole('member_manager') || hasRole('viewer')))
                    || (hasLinkedMemberProfile() && resource.data.tenantId == userTenantId())
                  );
      // Update: tenant staff, or a linked member editing their own RSVP
      allow update: if isSignedIn()
                    && (
                      (tenantAllowed(resource)
                        && (hasRole('owner') || hasRole('admin') || hasRole('member_manager')))
                      || (hasLinkedMemberProfile()
                          && resource.data.tenantId == userTenantId()
                          && resource.data.uid == request.auth.uid)
                    );
      // Delete: super admin or tenant staff
      allow delete: if isSignedIn()
                    && (isSuperAdmin() || (tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'))));
    }

    // ============================================
    // GROUPS
    // ============================================
    match /groups/{id} {
      // Any user with a linked member profile can read groups in their church
      allow read: if isSignedIn()
                  && hasLinkedMemberProfile()
                  && resource.data.tenantId == userTenantId();
      allow read: if isSignedIn()
                  && (isSuperAdmin() || (tenantAllowed(resource)
                  && (hasRole('owner') || hasRole('admin') || hasRole('member_manager') || hasRole('cell_leader') || hasRole('viewer'))));
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'));
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'));
      allow delete: if isSignedIn()
                    && (isSuperAdmin() || (tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin'))));
    }

    // ============================================
    // GROUP MEMBERS
    // Merged: tenant staff + linked congregation members (read own memberships).
    // ============================================
    match /group_members/{id} {
      allow read: if isSignedIn()
                  && (
                    isSuperAdmin()
                    || (tenantAllowed(resource)
                        && (hasRole('owner') || hasRole('admin') || hasRole('member_manager') || hasRole('cell_leader')))
                    || (hasLinkedMemberProfile() && resource.data.tenantId == userTenantId())
                  );
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'));
      allow delete: if isSignedIn()
                    && (isSuperAdmin() || (tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'))));
    }

    // ============================================
    // GROUP ATTENDANCE SESSIONS
    // ============================================
    match /group_attendance/{id} {
      allow read: if isSignedIn()
                  && (isSuperAdmin() || (tenantAllowed(resource)
                  && (hasRole('owner') || hasRole('admin') || hasRole('member_manager') || hasRole('cell_leader'))));
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager') || hasRole('cell_leader'));
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager') || hasRole('cell_leader'));
      allow delete: if isSignedIn()
                    && (isSuperAdmin() || (tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin'))));
    }

    // ============================================
    // GROUP ATTENDANCE RECORDS (per-member per-session)
    // ============================================
    match /group_attendance_records/{id} {
      allow read: if isSignedIn()
                  && (isSuperAdmin() || (tenantAllowed(resource)
                  && (hasRole('owner') || hasRole('admin') || hasRole('member_manager') || hasRole('cell_leader'))));
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager') || hasRole('cell_leader'));
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager') || hasRole('cell_leader'));
      allow delete: if isSignedIn()
                    && (isSuperAdmin() || (tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin'))));
    }

    // ============================================
    // WORSHIP: SONG LIBRARY (subcollection of tenant)
    // ============================================
    match /tenants/{tenantId}/songs/{id} {
      allow read: if isSignedIn() && tenantId == userTenantId();
      allow create, update: if isSignedIn()
                             && tenantId == userTenantId()
                             && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'))
                             && callerIsPaid();
      allow delete: if isSignedIn()
                    && tenantId == userTenantId()
                    && (hasRole('owner') || hasRole('admin'));
    }

    // ============================================
    // WORSHIP: SETLISTS (subcollection of tenant)
    // Merged: any tenant user can read; owner/admin/member_manager/super_admin write.
    // ============================================
    match /tenants/{tenantId}/setlists/{id} {
      allow read: if isSignedIn() && tenantId == userTenantId();
      allow create, update: if isSignedIn()
                             && tenantId == userTenantId()
                             && (hasRole('owner') || hasRole('admin') || hasRole('member_manager') || isSuperAdmin())
                             && callerIsPaid();
      allow delete: if isSignedIn()
                    && tenantId == userTenantId()
                    && (hasRole('owner') || hasRole('admin') || isSuperAdmin());
    }

    // ============================================
    // VOLUNTEER ROLES (subcollection of tenant)
    // ============================================
    match /tenants/{tenantId}/volunteerRoles/{id} {
      allow read: if isSignedIn() && tenantId == userTenantId();
      allow create: if isSignedIn()
                    && tenantId == userTenantId()
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'))
                    && callerIsPaid();
      // Delete stays open so a downgraded church can still remove old roles.
      allow delete: if isSignedIn()
                    && tenantId == userTenantId()
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'));
      allow update: if false;
    }

    // ============================================
    // VOLUNTEER ASSIGNMENTS (subcollection of tenant)
    // ============================================
    match /tenants/{tenantId}/volunteerAssignments/{id} {
      allow read: if isSignedIn() && tenantId == userTenantId();
      allow create: if isSignedIn()
                    && tenantId == userTenantId()
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'))
                    && callerIsPaid();
      allow delete: if isSignedIn()
                    && tenantId == userTenantId()
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'));
      allow update: if false;
    }

    // ============================================
    // DAILY SUMMARY SETTINGS (paid feature)
    // Doc id is the tenantId. The Cloud Function that sends the summary reads
    // this via the Admin SDK (bypasses these rules). Owner/admin of the tenant
    // may read; writing (turning it on / configuring) requires the paid plan.
    // ============================================
    match /summarySettings/{tenantId} {
      allow read: if isSignedIn()
                  && (isSuperAdmin()
                      || (tenantId == userTenantId() && (hasRole('owner') || hasRole('admin'))));
      allow create, update: if isSignedIn()
                            && tenantId == userTenantId()
                            && (hasRole('owner') || hasRole('admin'))
                            && callerIsPaid();
      allow delete: if isSignedIn() && isSuperAdmin();
    }

    // ============================================
    // MEMBER REQUESTS (public self-join form submissions)
    // Anyone can submit without auth. Admins review in dashboard.
    // ============================================
    match /memberRequests/{id} {
      allow create: if true;
      allow read, update, delete: if isSignedIn()
                                  && (isSuperAdmin()
                                      || (request.auth != null
                                          && resource.data.tenantId == userTenantId()
                                          && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'))));
    }

    // ============================================
    // SELF-SERVICE SIGNUPS
    // Written by API route (admin SDK) on registration.
    // Super admin: full access for management dashboard.
    // ============================================
    match /signups/{id} {
      allow read, write: if isSignedIn() && isSuperAdmin();
    }

    // ============================================
    // ANNOUNCEMENTS
    // ============================================
    match /announcements/{id} {
      allow read: if isSignedIn()
                  && (isSuperAdmin()
                      || (resource.data.tenantId == userTenantId()
                          && (canManageCommunications() || hasLinkedMemberProfile())));
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && canManageCommunications();
      allow update, delete: if isSignedIn()
                            && tenantAllowed(resource)
                            && canManageCommunications();
    }

    // ============================================
    // EVENT CHECK-INS
    // Congregation members can create their own check-ins and read them.
    // Admins/managers can read all check-ins for their church.
    // ============================================
    match /event_checkins/{id} {
      // Admin access
      allow read: if isSignedIn()
                  && (isSuperAdmin() || (tenantAllowed(resource)
                  && (hasRole('owner') || hasRole('admin') || hasRole('member_manager') || hasRole('viewer'))));
      // Any user with a linked member profile can read their own check-ins.
      // Do NOT add tenantId check here - it's not in the query's WHERE clause.
      allow read: if isSignedIn()
                  && hasLinkedMemberProfile()
                  && resource.data.uid == request.auth.uid;
      // Any authenticated tenant user can create a check-in for themselves.
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.tenantId == userTenantId();
      // Admins can also create check-ins on behalf of members (manual override)
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && (hasRole('owner') || hasRole('admin') || hasRole('member_manager'));
      allow delete: if isSignedIn()
                    && (isSuperAdmin() || (tenantAllowed(resource)
                    && (hasRole('owner') || hasRole('admin'))));
    }

    // ============================================
    // PUSH SUBSCRIPTIONS (per uid)
    // ============================================
    match /push_subscriptions/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ============================================
    // STAFF MEMBERS (church workers for payslip generation)
    // ============================================
    match /staff_members/{id} {
      allow read: if isSignedIn()
                  && tenantAllowed(resource)
                  && canReadFinance();
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && canManageFinance();
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && canManageFinance();
      allow delete: if isSignedIn()
                    && tenantAllowed(resource)
                    && canManageFinance();
    }

    // ============================================
    // PAYSLIP RECORDS (generated payslip history)
    // ============================================
    match /payslip_records/{id} {
      allow read: if isSignedIn()
                  && tenantAllowed(resource)
                  && canReadFinance();
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && canManageFinance();
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && canManageFinance();
      allow delete: if isSignedIn()
                    && tenantAllowed(resource)
                    && canManageFinance();
    }

    // ============================================
    // INVOICE RECORDS (generated invoice history + status tracking)
    // ============================================
    match /invoice_records/{id} {
      allow read: if isSignedIn()
                  && tenantAllowed(resource)
                  && canReadFinance();
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && canManageFinance();
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && canManageFinance();
      allow delete: if isSignedIn()
                    && tenantAllowed(resource)
                    && canManageFinance();
    }

    // ============================================
    // PASTORAL CARE LOGS (sensitive - owner and admin only)
    // ============================================
    match /care_logs/{id} {
      allow read: if isSignedIn()
                  && tenantAllowed(resource)
                  && (isSuperAdmin() || hasRole('owner') || hasRole('admin'));
      allow create: if isSignedIn()
                    && tenantAllowedWrite(request.resource.data)
                    && (isSuperAdmin() || hasRole('owner') || hasRole('admin'));
      allow update: if isSignedIn()
                    && tenantAllowed(resource)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && (isSuperAdmin() || hasRole('owner') || hasRole('admin'));
      allow delete: if isSignedIn()
                    && tenantAllowed(resource)
                    && (isSuperAdmin() || hasRole('owner') || hasRole('admin'));
    }

    // ============================================
    // EVERYTHING ELSE: deny by default
    // ============================================
  }
}
